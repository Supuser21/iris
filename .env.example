# App
# Production: https://talkwithiris.xyz
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEMO_URL=https://cal.com/patrykk
AUTH_SECRET=generate-a-random-32-char-string
DEV_OTP_MODE=true

# Database — Neon Postgres (free): https://neon.tech
# Use the pooled connection string (postgresql://...)
DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require

# OpenRouter (required for full chat)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# Web search: included via OpenRouter (web_search server tool). Optional extras:
# TAVILY_API_KEY=
# SERPER_API_KEY=
ASSISTANT_NAME=Iris

# SMS — pingram | twilio | telnyx
SMS_PROVIDER=pingram

# Pingram — https://pingram.io (secret key only on server)
PINGRAM_API_KEY=
PINGRAM_NOTIFICATION_TYPE=iris_sms
# PINGRAM_FROM_NUMBER=+16505093842

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Telnyx (alternative) — https://telnyx.com
TELNYX_API_KEY=
TELNYX_PHONE_NUMBER=

# Google Calendar (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cron — Vercel cron and/or external scheduler (every 5 min) hit /api/cron/process
CRON_SECRET=generate-another-random-string

# Later — Stripe
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
