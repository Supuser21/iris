# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
AUTH_SECRET=generate-a-random-32-char-string
DEV_OTP_MODE=true

# Database (SQLite local)
DATABASE_URL=file:./data/iris.db

# OpenRouter (required for full chat)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
ASSISTANT_NAME=Iris

# Twilio (SMS + OTP — set DEV_OTP_MODE=true to skip in dev)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Google Calendar (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cron (Vercel)
CRON_SECRET=generate-another-random-string

# Later — Stripe
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
